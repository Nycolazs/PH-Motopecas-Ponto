NODE_ENV=development
DATABASE_URL=postgresql://ph_ponto:ph_ponto_dev@localhost:55432/ph_ponto?schema=public
POSTGRES_DB=ph_ponto
POSTGRES_USER=ph_ponto
POSTGRES_PASSWORD=ph_ponto_dev
POSTGRES_PORT=55432
API_PORT=3000
API_HOST=0.0.0.0
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_ISSUER=ph-ponto-api
JWT_AUDIENCE=ph-ponto-desktop
JWT_ACCESS_TTL_SECONDS=300
REFRESH_IDLE_TTL_SECONDS=604800
REFRESH_ABSOLUTE_TTL_SECONDS=2592000
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_BLOCK_SECONDS=900
APP_TIMEZONE=America/Sao_Paulo
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-bootstrap-password
API_BASE_URL=http://localhost:3000
DESKTOP_DEV_ORIGIN=http://localhost:5173
UPLOAD_DIR=./data/uploads
SWAGGER_ENABLED=true
TRUST_PROXY_COUNT=0
DATABASE_CONNECTION_TIMEOUT_MS=2000
DATABASE_POOL_MAX=10

# WhatsApp late-arrival alerts (self-hosted OpenWA gateway, optional).
# Enable the gateway container with COMPOSE_PROFILES=whatsapp and set a random key
# with at least 32 characters (e.g. `openssl rand -hex 24`). Leave empty to disable.
COMPOSE_PROFILES=
OPENWA_API_KEY=
# Only needed when the API runs outside Docker Compose (local development).
# OPENWA_BASE_URL=http://127.0.0.1:2786

# Login protection. Per-login limit stops password guessing; the per-IP limit is
# higher because a whole store can share one public IP.
AUTH_LOGIN_IP_MAX_ATTEMPTS=30
# Proxies allowed to report the real client IP (X-Forwarded-For). In production the
# Cloudflare Tunnel reaches the API through the Docker gateway, e.g.:
# TRUST_PROXY_ADDRESSES=loopback,172.18.0.1
TRUST_PROXY_ADDRESSES=
