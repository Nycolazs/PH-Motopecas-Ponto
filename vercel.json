{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build:web",
  "outputDirectory": "dist",
  "installCommand": "pnpm install",
  "framework": "vite",
  "env": {
    "VITE_API_BASE_URL": "https://phmotopecas-api.yacacode.com"
  },
  "build": {
    "env": {
      "VITE_API_BASE_URL": "https://phmotopecas-api.yacacode.com"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
